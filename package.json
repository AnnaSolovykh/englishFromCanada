{
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel watch:sass watch:browser",
    "watch:sass": "sass --watch style.scss:style.css",
    "watch:browser": "browser-sync start --server --files '*.html, *.css, *.js, **/*.html, **/*.css, **/*.js'"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "^1.60.0"
  },
  "dependencies": {
    "browser-sync": "^2.29.1",
    "node-sass": "npm:sass@^1.60.0"
  }
}